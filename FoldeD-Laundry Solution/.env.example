# Client (Vite) — baked into the bundle at build time. Only the anon key may
# ever be exposed here; never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Edge Functions (set with `supabase secrets set`, not shipped to the browser).
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by the hosted Supabase runtime; the Razorpay trio is not.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
